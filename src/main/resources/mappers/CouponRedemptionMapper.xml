<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ecommerce.repository.CouponRedemptionRepository">
    <insert id="insert" parameterType="com.example.ecommerce.entity.CouponRedemption" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO coupon_redemptions(coupon_id, user_id, order_id, discount_amount)
        VALUES(#{couponId}, #{userId}, #{orderId}, #{discountAmount})
    </insert>
</mapper>
